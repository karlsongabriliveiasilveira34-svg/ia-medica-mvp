{
  "version": 2,
  "buildCommand": "npm install && cd ia-clinica-rag/frontend && npm install && npm run build",
  "outputDirectory": "ia-clinica-rag/frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/health",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
