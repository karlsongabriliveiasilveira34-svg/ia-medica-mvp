# ====================================================================
# CONFIGURAÇÕES DE AMBIENTE — MEDIa v2.0
# Copie este arquivo para .env e preencha suas chaves
# ====================================================================

PORT=3000
NODE_ENV=production
FRONTEND_URL=http://localhost:5174

# --- 1. BANCO DE DADOS POSTGRESQL / SUPABASE (COM PGVECTOR) ---
DATABASE_URL=postgresql://usuario:senha@localhost:5432/clinica_rag

# --- 2. GOOGLE GEMINI AI (MODELOS DE LINGUAGEM & EMBEDDINGS) ---
GEMINI_API_KEY=sua-chave-do-google-gemini-ai
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# --- 3. GOOGLE RECAPTCHA V2 / V3 (PROTEÇÃO ANTI-ROBÔ) ---
RECAPTCHA_SITE_KEY=sua-chave-publica-recaptcha-site-key
RECAPTCHA_SECRET_KEY=sua-chave-secreta-recaptcha-secret-key

# --- 4. SERVIÇO DE EMAIL (SMTP / GMAIL SENHA DE APP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app-16-digitos
SMTP_FROM="MedIa Tecnologia e Saúde <noreply@media.med.br>"

# --- 5. CHAVES CRIPTOGRÁFICAS & TOKENS JWT ---
JWT_SECRET=chave-super-secreta-jwt-de-pelo-menos-32-caracteres-aleatorios
REFRESH_TOKEN_SECRET=chave-super-secreta-refresh-de-pelo-menos-32-caracteres
PII_ENCRYPTION_KEY=chave-secreta-para-anonimizacao-lgpd-32-bytes

# --- 6. PAGAMENTOS PIX (BANCO CENTRAL) ---
PIX_CHAVE=38984045635
