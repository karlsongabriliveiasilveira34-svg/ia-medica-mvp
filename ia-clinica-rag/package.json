{
  "name": "ia-clinica-rag",
  "version": "1.0.0",
  "description": "Sistema de IA Clínica RAG com Arquitetura de Agentes e pgvector",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "concurrently \"nodemon src/server.js\" \"cd frontend && npm run dev\"",
    "dev:backend": "nodemon src/server.js",
    "db:migrate": "node src/database/migrate.js",
    "import:medmcqa": "node scripts/import-medmcqa.js",
    "ingest": "node src/services/ingest-documents.js",
    "generate-jwt": "node scripts/generate-jwt.js",
    "test": "npm run test:all",
    "test:all": "node tests/test-residency-roadmaps.js && node tests/validate-5000-questions.js && node tests/test-unimontes-roadmap.js && node tests/test-stress-and-security-attacks.js",
    "test:stress": "node tests/test-stress-and-security-attacks.js",
    "security:check": "node scripts/security-audit-check.js",
    "security:audit": "npm audit --audit-level=high"
  },
  "keywords": [
    "rag",
    "gemini",
    "pgvector",
    "medical-ai",
    "agents"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@google/generative-ai": "^0.24.1",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "uuid": "^11.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.14"
  }
}
