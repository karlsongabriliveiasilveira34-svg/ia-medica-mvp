{
  "name": "ia-clinica-rag",
  "version": "1.0.0",
  "description": "Sistema de IA Clínica RAG com Arquitetura de Agentes e pgvector",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "concurrently \"nodemon src/server.js\" \"cd frontend && npm run dev\"",
    "dev:backend": "nodemon src/server.js",
    "db:migrate": "node src/database/migrate.js",
    "ingest": "node src/services/ingest-documents.js",
    "generate-jwt": "node scripts/generate-jwt.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "rag",
    "gemini",
    "pgvector",
    "medical-ai",
    "agents"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.16.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "uuid": "^11.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.14"
  }
}
